rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // Standard edition. Durable writes are server-owned and validated by services.
  // User roles, assignments, money, PIN secrets and audit records are never client-writable.
  function signedIn() { return request.auth != null; }
  function owner(uid) { return signedIn() && request.auth.uid == uid; }
  function active() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active'; }
  function participant(ride) { return active() && (ride.riderId == request.auth.uid || ride.driverId == request.auth.uid); }
  match /users/{uid} { allow get: if owner(uid); allow list, write: if false; }
  match /drivers/{uid} {
   allow get: if active() && owner(uid); allow list, write: if false;
   match /offers/{rideId} { allow read: if active() && owner(uid) && exists(/databases/$(database)/documents/drivers/$(uid)); allow write: if false; }
  }
  match /vehicles/{vehicleId} { allow get: if active() && resource.data.driverId == request.auth.uid; allow list, write: if false; }
  match /quotes/{quoteId} { allow get: if active() && resource.data.riderId == request.auth.uid; allow list, write: if false; }
  match /rides/{rideId} {
   allow read: if participant(resource.data); allow write: if false;
   match /events/{eventId} { allow read: if exists(/databases/$(database)/documents/rides/$(rideId)) && participant(get(/databases/$(database)/documents/rides/$(rideId)).data); allow write: if false; }
  }
  match /reviews/{rideId} { allow get: if active() && resource.data.riderId == request.auth.uid; allow list, write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
